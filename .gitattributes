# Normalize line endings.
#
# Store LF in the repository and check out LF on every platform. Without this,
# `core.autocrlf=true` (Windows default) rewrites LF to CRLF on checkout, which
# makes `prettier --check` fail on every file (the repo sets endOfLine: lf).
* text=auto eol=lf

# Binary assets — never normalize, never diff.
*.jpg binary
*.jpeg binary
*.png binary
*.gif binary
*.ico binary
*.webp binary
*.pdf binary
*.woff binary
*.woff2 binary
*.ttf binary
*.eot binary
*.mp4 binary
*.webm binary
*.zip binary
