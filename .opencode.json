{
  "$schema": "https://opencode.ai/config.json",
  "permission": {
    "bash": {
      "*": "ask",
      "npm *": "allow",
      "yarn *": "allow",
      "pnpm *": "allow",
      "npx *": "allow",
      "git status": "allow",
      "git diff *": "allow",
      "git log *": "allow",
      "git push *": "ask",
      "git commit *": "ask",
      "git add *": "ask",
      "gh pr create *": "allow",
      "gh pr list *": "allow",
      "gh pr view *": "allow",
      "gh auth status": "allow",
      "Remove-Item *": "ask",
      "rm *": "ask",
      "del *": "ask"
    }
  }
}
