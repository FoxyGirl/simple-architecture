{
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2023"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "moduleDetection": "force",

    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedSideEffectImports": true,

    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "erasableSyntaxOnly": true,
    "skipLibCheck": true,
    "noEmit": true,

    "types": ["node"],

    // `~` is the backend root, so routes never climb with deep relative paths.
    // Kept in sync with the alias in server/vitest.config.ts and eslint.config.js,
    // and honoured at runtime by tsx (reads this tsconfig for path mapping).
    "paths": {
      "~/*": ["./*"]
    }
  },
  "include": ["**/*.ts"]
}
